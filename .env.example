# OpenRouter API Configuration (GPT-4o / GPT-4o-mini)
# Paste your OpenRouter API key below (format: sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2

# Provider Selection
CLASSIFIER_PROVIDER=openrouter
ATTRIBUTE_PROVIDER=moda_ner
DIGITISATION_PROVIDER=gpt
DETECTION_PROVIDER=openrouter
EMBEDDING_PROVIDER=siglip

# Runpod (MODA SigLIP embedding + MODA_NER attribute extraction)
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_BASE_URL=https://api.runpod.ai/v2
RUNPOD_EMBEDDING_ENDPOINT_ID=your_moda_embed_endpoint_id
RUNPOD_ATTRIBUTE_ENDPOINT_ID=your_moda_ner_endpoint_id

# App
ENV=development
DEBUG=true
WORKER_CONCURRENCY=30

# Database / Queue (docker-compose service hostnames — this project only runs via `docker compose up`)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/wardrobe
REDIS_URL=redis://redis:6379/0
USE_IN_MEMORY_QUEUE=false

# Storage (must match the postgres/minio service credentials in docker-compose.yml)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=wardrobe-assets
S3_REGION=us-east-1

# Auth (dev-only defaults — see app/config.py)
AUTH_SECRET_KEY=change-me-to-a-random-secret-in-production
AUTH_TOKEN_EXPIRE_DAYS=7
