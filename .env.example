# OpenRouter API Configuration (GPT-4o / GPT-4o-mini)
# Paste your OpenRouter API key below (format: sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GENAI_MODEL=openai/dall-e-3

# Provider Selection
ATTRIBUTE_PROVIDER=openrouter
DIGITISATION_PROVIDER=gpt
DETECTION_PROVIDER=opencv

# Storage & Infrastructure (Default Local / Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wardrobe
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_QUEUE=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=wardrobe-assets
