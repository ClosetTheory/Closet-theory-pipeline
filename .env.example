# Environment Configuration
ENV=development
DEBUG=true
PIPELINE_VERSION=1.0.0

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wardrobe

# Storage ("local" or "s3")
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=wardrobe-assets
S3_REGION=us-east-1

# Redis / Queue
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_QUEUE=true

# AI / ML Model Providers ("mock", "mobilenet", "retina_sam", "gemini", "claude", "moda_ner", "flux", "siglip")
CLASSIFIER_PROVIDER=mock
CLASSIFIER_MODEL_NAME=MobileNetV3
CLASSIFIER_CONFIDENCE_THRESHOLD=0.70

DETECTION_PROVIDER=mock
DETECTION_MODEL_NAME=RetinaFace+SAM

ATTRIBUTE_PROVIDER=mock
ATTRIBUTE_MODEL_NAME=MODA_NER
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

DIGITISATION_PROVIDER=mock
DIGITISATION_MODEL_NAME=FLUX.2
DIGITISATION_MAX_RETRIES=3
DIGITISATION_QUALITY_THRESHOLD=0.75

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=MODA SigLIP Distilled
EMBEDDING_DIMENSION=768

VLM_PROVIDER=mock
VLM_MODEL_NAME=gemini-flash
